{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "composite": false,
    "declaration": false,
    "declarationMap": false,
    "noEmit": true,
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": ["vite/client"],
    "jsx": "react-jsx",
    "paths": {
      "@/*": ["./src/renderer/*"],
      "@cairn/core": ["../../packages/core/src/index.ts"],
      "@cairn/core/*": ["../../packages/core/src/*"],
      "@cairn/ui": ["../../packages/ui/src/index.ts"],
      "@cairn/ui/*": ["../../packages/ui/src/*"]
    }
  },
  "references": [{ "path": "../../packages/core" }, { "path": "../../packages/ui" }],
  "include": ["src/renderer/**/*.ts", "src/renderer/**/*.tsx", "src/shared/**/*.ts"],
  "exclude": ["src/**/*.test.ts", "src/**/*.test.tsx"]
}
