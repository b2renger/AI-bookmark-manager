# Secrets — runtime keys live in Electron safeStorage; .env is dev-only and never committed
.env
.env.*
!.env.example

# Dependencies / build output
node_modules
dist
out
release
*.tsbuildinfo
.tmp-*

# Databases and generated fixtures (the tiny fixture under fixtures/ IS committed)
*.db
*.db-wal
*.db-shm
*.sqlite
.fixtures/
snapshots/
models/
.cache/

# Test artefacts
eval/reports/
playwright-report/
test-results/
coverage/

# Logs
logs
*.log
npm-debug.log*

# Editor / OS
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Generated declaration output
dist-types/
