{
  "name": "cairn-workspace",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Cairn — local-first, shareable AI bookmark manager (workspace root)",
  "author": "Bérenger Recoules",
  "packageManager": "npm@11.12.1",
  "engines": {
    "node": ">=24.0.0 <25",
    "npm": ">=11"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm -w @cairn/desktop run dev",
    "build": "npm run typecheck && npm -w @cairn/desktop run build",
    "typecheck": "tsc -b --pretty false",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run --project core --project ui --project main",
    "test:watch": "vitest --project core --project ui",
    "test:scale": "cross-env CAIRN_FIXTURE=.fixtures/library-100k.db vitest run --project scale",
    "test:e2e": "playwright test -c apps/desktop/playwright.config.ts",
    "fixture:gen": "node packages/core/scripts/genFixture.ts",
    "migrations": "node apps/desktop/scripts/gen-migrations.mjs",
    "i18n:check": "node apps/desktop/scripts/check-i18n.mjs",
    "rebuild": "npm -w @cairn/desktop run rebuild",
    "package": "npm run lint && npm run typecheck && npm run rebuild && npm -w @cairn/desktop run build && electron-builder -c apps/desktop/electron-builder.yml --publish never",
    "package:dir": "npm -w @cairn/desktop run build && electron-builder -c apps/desktop/electron-builder.yml --dir"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "cross-env": "^10.1.0",
    "eslint": "^10.10.0",
    "eslint-plugin-i18next": "^6.1.5",
    "eslint-plugin-import-x": "^4.17.1",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.70.0",
    "vitest": "^5.0.0"
  }
}
